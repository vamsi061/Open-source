# Supabase connection (Dashboard -> Project Settings -> API).
# OPTIONAL: without a .env the app runs zero-config on a local SQLite database
# (data/local.db, seeded from src/db/seed.json on first start).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Optional: server port (default 4000)
# PORT=4000
